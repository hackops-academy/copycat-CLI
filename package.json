{
  "name": "copycat-cli-gui",
  "productName": "CopyCat GUI",
  "version": "3.0.0",
  "description": "CopyCat GUI — Mirror | Recon | Mindmap. HUD-style desktop front-end for CopyCat-CLI. HackOps Academy.",
  "main": "main.js",
  "author": "HackOps Academy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "vis-data": "^7.1.10",
    "vis-network": "^9.1.13"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hackopsacademy.copycatgui",
    "productName": "CopyCat GUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
